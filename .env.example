TUSHARE_VALUE_PROXY=000016.SH
TUSHARE_TECH_PROXY=399006.SZ
TUSHARE_BROAD_PROXY=000300.SH
TUSHARE_GOLD_ETF_PROXIES=518880.SH,159934.SZ
